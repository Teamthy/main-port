# Enforces consistent encoding + line endings across editors/OSes.
# This is what prevents the "â€” / âœ¦ / Ã—" mojibake and CRLF churn.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
