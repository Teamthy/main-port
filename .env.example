# Copy this file to .env.local and fill in the values.

# --- Contact form (Resend) ---
# Get an API key at https://resend.com/api-keys
# Leave unset in development: the API route will log messages to the console instead of emailing.
RESEND_API_KEY=

# Where contact form submissions are delivered (defaults to olusanyatimothy54@gmail.com)
CONTACT_TO_EMAIL=olusanyatimothy54@gmail.com

# Verified sender in Resend (e.g. "Portfolio Contact <hello@yourdomain.com>")
# Defaults to Resend's onboarding sender, which only delivers to your own inbox.
CONTACT_FROM_EMAIL=

# --- Site ---
# Used for canonical URLs / OpenGraph metadata
NEXT_PUBLIC_SITE_URL=https://olusanyatimothy.dev
