# Normalize line endings in the repo so Windows/macOS/Linux don't fight.
* text=auto eol=lf

# Binaries: never try to diff or convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Scripts that must stay LF even on Windows.
*.sh text eol=lf
